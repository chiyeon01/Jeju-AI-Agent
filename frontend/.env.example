# ─────────────────────────────────────────────
# 제주잇다 프론트엔드 환경 변수
# 이 파일을 복사해 .env 로 만들고 값을 채우세요.  (Windows: copy .env.example .env)
# Vite 는 VITE_ 로 시작하는 변수만 브라우저 코드에 노출합니다. 값은 src/config.js 에서만 읽습니다.
# ─────────────────────────────────────────────

# true  : 목업 데이터로 동작 (백엔드 없이 화면 확인, 시연 계정으로 로그인)
# false : 아래 API 주소의 백엔드를 호출
VITE_USE_MOCK=true

# 백엔드 API 주소 (개발 중에는 vite 프록시가 /api → http://localhost:8000 으로 넘깁니다)
VITE_API_BASE_URL=/api/v1

# 카카오맵 JavaScript 키
#  1) https://developers.kakao.com > 내 애플리케이션 > 앱 추가
#  2) 앱 키 > JavaScript 키 복사
#  3) 플랫폼 > Web > 사이트 도메인에 http://localhost:5173 (배포 주소도) 등록
#  4) 카카오맵 > 활성화 설정 ON
VITE_KAKAO_MAP_KEY=

# Main PC 관리 콘솔 실시간 이벤트 스트림 (WebSocket)
VITE_EVENT_STREAM_URL=ws://localhost:8000/ws/events

# ⚠️ Claude API 키, 제주데이터허브 API 키, JWT 비밀키는 브라우저에 노출되면 안 되므로
#    여기에 넣지 말고 백엔드 .env 에 넣습니다.
