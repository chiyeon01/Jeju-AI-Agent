# ─────────────────────────────────────────────
# 제주잇다 프론트엔드 환경 변수
# 이 파일을 복사해 .env 로 만들고 값을 채우세요.  (Windows: copy .env.example .env)
# Vite 는 VITE_ 로 시작하는 변수만 브라우저 코드에 노출합니다. 값은 src/config.js 에서만 읽습니다.
# ─────────────────────────────────────────────

# true  : 목업 데이터로 동작 (백엔드 없이 화면 확인, 시연 계정으로 로그인)
# false : 백엔드를 호출
VITE_USE_MOCK=false

# 개발 서버(npm run dev)가 /api, /ws 요청을 넘길 백엔드 주소
#   배포 서버 : https://jejuai.duckdns.org
#   내 PC 백엔드 : http://localhost:8000
VITE_PROXY_TARGET=https://jejuai.duckdns.org

# 브라우저가 부르는 API 주소. 경로만 두면 위 프록시를 거치므로 CORS 걱정이 없습니다.
# (빌드해서 다른 도메인에 올릴 때만 https://jejuai.duckdns.org/api/v1 처럼 전체 주소를 넣습니다)
VITE_API_BASE_URL=/api/v1

# 카카오맵 JavaScript 키
#  1) https://developers.kakao.com > 내 애플리케이션 > 앱 추가
#  2) 앱 키 > JavaScript 키 복사
#  3) 플랫폼 > Web > 사이트 도메인에 http://localhost:5173 (배포 주소도) 등록
#  4) 카카오맵 > 활성화 설정 ON
VITE_KAKAO_MAP_KEY=

# 관리 화면 실시간 이벤트 WebSocket. 경로만 두면 프록시를 거쳐 VITE_PROXY_TARGET 으로 붙습니다.
# (전체 주소 예: wss://jejuai.duckdns.org/ws/events)
VITE_EVENT_STREAM_URL=/ws/events

# 실시간 날씨 (기상청 초단기실황). 비워 두면 키가 필요 없는 Open-Meteo 로 자동으로 가져옵니다.
#  1) https://www.data.go.kr 회원가입·로그인
#  2) "기상청_단기예보 ((구)_동네예보) 조회서비스" 검색 > 활용신청 (자동 승인, 반영까지 1~2시간)
#  3) 마이페이지 > 데이터 활용 > Open API > 활용신청 현황 > 일반 인증키(Decoding) 복사해서 아래에 붙여넣기
#     (Encoding 키를 넣어도 동작합니다)
# 개발 서버가 /kma 를 https://apis.data.go.kr 로 넘겨 주므로 다른 설정은 필요 없습니다.
VITE_KMA_SERVICE_KEY=

# ⚠️ 제주데이터허브 API 키, 카카오 REST 키, JWT 비밀키는 브라우저에 노출되면 안 되므로
#    여기에 넣지 말고 백엔드 .env 에 넣습니다. GPT 키(OPENAI_API_KEY)도 백엔드에만 두고, 웹은 백엔드를 거쳐 GPT 를 씁니다.

# 백엔드에 GPT 중계 API(/tourist/ai/json)가 있을 때만 true. 지금 백엔드에는 없으므로 비워 둡니다.
VITE_GPT_RELAY=
