# ─────────────────────────────────────────────
# 제주잇다 프론트엔드 환경 변수
# 이 파일을 복사해 .env 로 만들고 값을 채우세요.  (cp .env.example .env)
# Vite 는 VITE_ 로 시작하는 변수만 브라우저 코드에 노출합니다.
# ─────────────────────────────────────────────

# true  : 목업 데이터로 동작 (백엔드 없이 화면 확인)
# false : 아래 API 주소의 FastAPI 백엔드를 호출
VITE_USE_MOCK=true

# FastAPI 백엔드 주소 (개발 중에는 vite 프록시가 /api → localhost:8000 으로 넘깁니다)
VITE_API_BASE_URL=/api

# 지도 표시용 JavaScript 키 (카카오맵 등 실제 지도로 교체할 때 사용)
VITE_MAP_JS_KEY=

# Main PC 관리 콘솔 실시간 이벤트 스트림 (WebSocket / SSE)
VITE_EVENT_STREAM_URL=ws://localhost:8000/ws/events

# ⚠️ Claude API 키(ANTHROPIC_API_KEY)와 제주데이터허브 API 키는
#    브라우저에 노출되면 안 되므로 여기에 넣지 마세요.
#    백엔드(FastAPI) 쪽 .env 에 넣습니다.
