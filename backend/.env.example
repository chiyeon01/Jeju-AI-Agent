# ─────────────────────────────────────────────
# 제주잇다 백엔드(FastAPI) 환경 변수
# 이 파일을 복사해 .env 로 만들고 값을 채우세요.
#   cp .env.example .env            (bash)
#   copy .env.example .env          (Windows PowerShell)
# .env 는 git에 올라가지 않습니다 (.gitignore 참고). 키 값은 이 파일에만 넣으세요.
# ─────────────────────────────────────────────

# ── OpenAI(GPT) API ──────────────────────────
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=
# 사용할 모델. 비용·속도 우선이면 gpt-4o-mini, 품질 우선이면 gpt-4o 등으로 교체하세요.
OPENAI_MODEL=gpt-4o-mini
# 요청 타임아웃(초)
OPENAI_TIMEOUT_SECONDS=20

# ── 실시간 날씨 (GET /api/v1/weather/now) ──────
# 기상청 단기예보 서비스키 (공공데이터포털). 비우면 Open-Meteo(키 없음)로 가져옵니다.
KMA_SERVICE_KEY=

# ── 장소 대표 사진 (GET /api/v1/places/photo) ──
# 네이버 개발자센터(developers.naver.com)에서 '검색' API 애플리케이션을 만들고 받은 값. 비우면 사진 없이 동작합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 제주데이터허브 / 제주빅데이터센터 API ─────
# 실데이터 연동 시 사용. 비워두면 backend/app/data 의 합성(목업) 데이터로 동작합니다.
JEJU_DATA_HUB_API_KEY=
JEJU_DATA_HUB_BASE_URL=https://open.jejudatahub.net/api/proxy

# ── 카카오맵(Kakao Local) API ─────────────────
# https://developers.kakao.com/console/app → 내 애플리케이션 → 앱 키 → REST API 키
# (주의: 지도를 화면에 그리는 JavaScript 키는 이 키와 다르며, 브라우저에 노출되는
#  frontend/.env 의 VITE_KAKAO_MAP_KEY 입니다. 여기 넣는 REST API 키는 주소 검색·
#  좌표→행정동 변환처럼 비밀로 유지해야 하는 서버 전용 호출에만 씁니다.)
KAKAO_REST_API_KEY=

# ── 서버 설정 ─────────────────────────────────
# 프론트엔드(Vite) 개발 서버 주소. 쉼표로 여러 개 지정 가능.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 데이터 저장 파일 경로 (방문 평가·사장님 조치 등 자체 생성 데이터를 쌓는 SQLite 파일)
DATABASE_PATH=./storage/jejuitda.db

# API 키가 없거나 호출이 실패해도 서비스가 멈추지 않도록, 규칙 기반 응답으로 자동 대체합니다.
# false 로 두면 GPT 실패 시 에러를 그대로 반환합니다 (디버깅용).
LLM_FALLBACK_ON_ERROR=true

# 제주데이터허브에서 받아 둔 파일 데이터 폴더 (관리 콘솔 '원천 데이터 적재 이력'에 표시)
DATA_DIR=../data

# ── 로그인 (JWT) ──────────────────────────────
# 비워두면 처음 실행할 때 storage/.jwt_secret 에 무작위 값을 만들어 계속 씁니다.
# 여러 서버가 같은 토큰을 받아야 하면 긴 무작위 문자열을 직접 넣으세요.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# 시연 계정 자동 생성 (user@jeju.kr / owner@jeju.kr / admin@jeju.kr, 비밀번호 jeju1234)
# 실제 운영에서는 false 로 두세요.
SEED_DEMO_ACCOUNTS=true
